---
import "../fonts.css";
import Sidebar from "../components/Sidebar.astro";
import { terms } from "../data/terms.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Internetwork Course" } = Astro.props;
const course = Astro.url.pathname.includes("/dbsec") ? "dbsec" : "internetwork";
---

<!doctype html>
<html lang="th" data-course={course}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
  <title>{title} · Internetwork Course</title>
</head>
<body>
  <div class="shell">
    <Sidebar />
    <main>
      <slot />
    </main>
  </div>

  <div id="term-tooltip" class="term-tooltip" role="tooltip" hidden></div>

  <script define:vars={{ terms }}>
    window.__TERMS__ = terms;
  </script>
  <script>
    (function () {
      const tooltip = document.getElementById("term-tooltip");
      if (!tooltip) return;
      const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      let activeTrigger = null;

      function render(data) {
        tooltip.innerHTML = "";
        const strong = document.createElement("strong");
        strong.textContent = data.term;
        tooltip.appendChild(strong);
        if (data.full) {
          const full = document.createElement("span");
          full.className = "term-full";
          full.textContent = data.full;
          tooltip.appendChild(full);
        }
        const p = document.createElement("p");
        p.textContent = data.def;
        tooltip.appendChild(p);
      }

      function position(trigger) {
        const rect = trigger.getBoundingClientRect();
        const margin = 10;
        const tw = tooltip.offsetWidth;
        const th = tooltip.offsetHeight;
        let left = rect.left + rect.width / 2 - tw / 2;
        left = Math.max(margin, Math.min(left, window.innerWidth - tw - margin));
        let top = rect.bottom + 8;
        if (top + th > window.innerHeight - margin) {
          top = rect.top - th - 8;
        }
        tooltip.style.left = left + window.scrollX + "px";
        tooltip.style.top = top + window.scrollY + "px";
      }

      function show(trigger) {
        const data = window.__TERMS__ && window.__TERMS__[trigger.dataset.termId];
        if (!data) return;
        activeTrigger = trigger;
        render(data);
        tooltip.hidden = false;
        position(trigger);
        trigger.setAttribute("aria-expanded", "true");
      }

      function hide() {
        if (!activeTrigger) return;
        tooltip.hidden = true;
        activeTrigger.setAttribute("aria-expanded", "false");
        activeTrigger = null;
      }

      if (supportsHover) {
        document.addEventListener("mouseover", (e) => {
          const t = e.target.closest(".term");
          if (t) show(t);
        });
        document.addEventListener("mouseout", (e) => {
          const t = e.target.closest(".term");
          if (t && (!e.relatedTarget || !t.contains(e.relatedTarget))) hide();
        });
      } else {
        document.addEventListener("click", (e) => {
          const t = e.target.closest(".term");
          if (t) {
            e.preventDefault();
            if (activeTrigger === t) {
              hide();
            } else {
              show(t);
            }
            return;
          }
          if (!tooltip.contains(e.target)) hide();
        });
      }

      document.addEventListener("focusin", (e) => {
        const t = e.target.closest(".term");
        if (t) show(t);
      });
      document.addEventListener("focusout", (e) => {
        const t = e.target.closest(".term");
        if (t) hide();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") hide();
      });
      window.addEventListener("scroll", () => { if (activeTrigger) position(activeTrigger); }, { passive: true });
      window.addEventListener("resize", () => { if (activeTrigger) position(activeTrigger); });
    })();
  </script>
</body>
</html>

<style is:global>
  :root{
    --paper:#FAF9F5; --paper-2:#F0EEE6; --card:#FFFFFF;
    --ink:#1F1E1D; --ink-2:#54524C; --ink-3:#8C8A80;
    --rule:#DFDBD0; --rule-soft:#EAE7DE;
    --coral:#C4623B; --coral-soft:#F3E2DA;
    --slate:#3D6B7C; --slate-soft:#DFEAEE;
    --gold:#A8792A; --gold-soft:#F1E6D0;
    --violet:#6E5A9C; --violet-soft:#E8E3F3;
    --fwd:#4A7350; --fwd-soft:#E3EFE1; --blk:#A34A3C; --blk-soft:#F0DEDA;
    --sage:#728A42; --sage-soft:#E9EDD8;
    --syn-tag:#7EB6DE; --syn-attr:#E3A85E; --syn-str:#9AC97D; --syn-cm:#9C9A90;
    --shadow:0 1px 2px rgba(31,30,29,.05), 0 8px 24px rgba(31,30,29,.06);
    --sans:'Sarabun',"Leelawadee UI","Segoe UI",system-ui,-apple-system,sans-serif;
    --serif:Georgia,"Times New Roman",serif;
    --mono:"Cascadia Mono",Consolas,ui-monospace,monospace;
  }
  :root[data-course="dbsec"]{
    --paper:#F7FAE9; --paper-2:#ECF2D6;
    --rule:#D9E0BE; --rule-soft:#E5EBCF;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.65;font-size:15.5px}
  .shell{display:flex;align-items:flex-start}
  main{flex:1;min-width:0;max-width:1000px;margin:0 auto;padding:24px 32px 80px}
  @media (max-width:860px){
    .shell{flex-direction:column}
    main{max-width:100%;padding:24px 22px 80px}
  }

  /* ---- masthead ---- */
  .masthead{text-align:center;padding-bottom:26px;border-bottom:3px solid var(--ink);margin-bottom:8px}
  .masthead .eyebrow{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;font-weight:700;margin:0 0 14px}
  .masthead h1{font-family:var(--serif);font-size:clamp(1.9rem,5.2vw,3.3rem);font-weight:400;letter-spacing:-.015em;margin:0 0 10px;text-wrap:balance;line-height:1.1}
  .masthead .deck{margin:0 auto;max-width:64ch;color:var(--ink-2);font-size:1rem}
  .credit-bar{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;padding:12px 0 0;font-size:.78rem;color:var(--ink-3)}
  .credit-bar span{background:var(--paper-2);border:1px solid var(--rule-soft);padding:3px 12px;border-radius:999px;font-family:var(--mono);font-size:.72rem}

  section{margin-top:44px}
  .sec-head{display:flex;align-items:center;gap:12px;margin-bottom:6px}
  .sec-head .mark{flex:none;margin:0}
  .sec-head h2{margin:0;font-size:1.18rem;font-weight:800;letter-spacing:-.01em}
  .sec-sub{margin:0 0 20px 38px;color:var(--ink-2);font-size:.95rem;max-width:74ch}
  @media (max-width:600px){ .sec-sub{margin-left:0} }

  .grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
  .grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px}

  .card{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow)}
  .card h3{margin:0 0 10px;font-size:1rem;font-weight:800}
  .card ul{margin:0;padding-left:18px;color:var(--ink-2);font-size:.93rem}
  .card ul li{margin-bottom:7px}
  .card ul li:last-child{margin-bottom:0}
  .card ul li b{color:var(--ink)}

  code{font-family:var(--mono);font-size:.86em;background:var(--paper-2);padding:1px 5px;border-radius:4px;color:var(--ink)}

  figure{margin:0}
  .figwrap{background:var(--card);border:1px solid var(--rule-soft);border-radius:16px;padding:18px;box-shadow:var(--shadow);overflow-x:auto}
  svg{display:block;max-width:100%;height:auto}
  .figwrap svg{margin:0 auto}
  figcaption{margin-top:12px;font-size:.88rem;color:var(--ink-3);text-align:center;max-width:78ch;margin-left:auto;margin-right:auto}

  .pathway{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0}
  .pw-step{position:relative;background:var(--card);border:1px solid var(--rule-soft);padding:16px 18px}
  .pw-step:first-child{border-radius:14px 0 0 14px}
  .pw-step:last-child{border-radius:0 14px 14px 0}
  .pw-step + .pw-step{border-left:none}
  @media (max-width:840px){ .pw-step,.pw-step:first-child,.pw-step:last-child{border-radius:14px;margin-bottom:10px;border-left:1px solid var(--rule-soft)} }
  .pw-step .n{font-family:var(--mono);font-size:.7rem;font-weight:700;letter-spacing:.1em;display:block;margin-bottom:6px}
  .pw-step h4{margin:0 0 6px;font-size:.93rem;font-weight:800}
  .pw-step p{margin:0;font-size:.85rem;color:var(--ink-2)}

  .cascade{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .rung{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:16px 18px;box-shadow:var(--shadow);border-top:3px solid var(--coral)}
  .rung .step-n{font-family:var(--serif);font-size:1.9rem;line-height:1;color:var(--coral);display:block;margin-bottom:6px}
  .rung h4{margin:0 0 4px;font-size:.97rem;font-weight:800}
  .rung .what{margin:0 0 10px;font-size:.86rem;color:var(--ink-2)}
  .rung .lab{font-size:.82rem;background:var(--paper-2);border-radius:8px;padding:8px 10px;color:var(--ink-2)}
  .rung .lab b{color:var(--ink)}

  .inst-card{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:18px;box-shadow:var(--shadow)}
  .inst-card .head{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:2px}
  .inst-card h4{margin:0;font-family:var(--mono);font-size:1.02rem;font-weight:700}
  .inst-card .vl{font-size:.78rem;color:var(--ink-3);font-family:var(--mono)}
  .inst-card .rootline{font-size:.85rem;color:var(--ink-2);margin:0 0 10px}
  .inst-card .rootline b{color:var(--ink)}
  .inst-card .result{margin:10px 0 0;font-size:.82rem;font-family:var(--mono);padding-top:10px;border-top:1px dashed var(--rule);color:var(--ink-2)}
  .inst-card .result b{color:var(--ink)}

  .knob{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow);overflow-x:auto}
  .knob .where{display:inline-block;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:2px 9px;border-radius:999px;margin-bottom:8px}
  .knob .where.c1{color:var(--coral);background:var(--coral-soft)}
  .knob .where.c2{color:var(--gold);background:var(--gold-soft)}
  .knob .where.c3{color:var(--violet);background:var(--violet-soft)}
  .knob h3{margin:0 0 4px;font-size:1rem}
  .knob .why{margin:0 0 14px;font-size:.87rem;color:var(--ink-2)}
  .knob pre{margin:0 0 12px;font-family:var(--mono);font-size:.78rem;background:var(--paper-2);padding:10px 12px;border-radius:8px;overflow-x:auto;color:var(--ink);white-space:pre-wrap}
  .knob .out{font-family:var(--mono);font-size:.74rem;background:var(--ink);color:var(--paper);padding:9px 11px;border-radius:8px;overflow-x:auto;margin:0;white-space:pre}

  table{width:100%;border-collapse:collapse;font-size:.9rem}
  caption{text-align:left;font-weight:800;padding-bottom:10px;font-size:1rem}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--rule-soft);vertical-align:top}
  thead th{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3);border-bottom:2px solid var(--rule)}
  tbody th{font-family:var(--mono);font-weight:700;font-size:.82rem;white-space:nowrap;color:var(--ink)}
  td{color:var(--ink-2)}
  .tablewrap{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow);overflow-x:auto}
  td.center{text-align:center;font-family:var(--mono)}

  .exam{background:var(--card);border:1px solid var(--rule-soft);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow);border-left:4px solid var(--gold)}
  .exam h4{margin:0 0 8px;font-size:.97rem;display:flex;align-items:center;gap:8px}
  .exam .tag{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--gold);border:1.5px solid var(--gold);border-radius:999px;padding:1px 8px;white-space:nowrap}
  .exam p{margin:0 0 8px;font-size:.88rem;color:var(--ink-2)}
  .exam p:last-child{margin-bottom:0}

  .fixnote{margin-top:20px;border-radius:12px;padding:14px 18px;font-size:.9rem;color:var(--ink)}
  .fixnote b{color:inherit}

  /* ---- ป้ายกำกับเนื้อหาเสริมที่ไม่ได้อยู่ในสไลด์ที่อาจารย์สอน ---- */
  .badge-extra{
    display:inline-block;font-size:.6rem;letter-spacing:.08em;font-weight:700;
    color:var(--ink-3);background:var(--paper-2);
    border:1px solid var(--rule);border-radius:999px;
    padding:2px 9px;white-space:nowrap;vertical-align:middle;
    margin-left:8px;text-transform:none;
  }
  .sec-head .badge-extra{align-self:center}
  section:has(> .sec-head .badge-extra) > .sec-head h2{color:var(--ink-2)}
  .legend-note{
    background:var(--paper-2);border:1px dashed var(--rule);
    border-radius:12px;padding:14px 18px;font-size:.89rem;color:var(--ink-2);
  }
  .legend-note b{color:var(--ink)}

  .bridge{background:var(--violet-soft);border-radius:14px;padding:18px 22px;font-size:.92rem;color:var(--ink)}
  .bridge b{color:var(--violet)}

  footer{max-width:1180px;margin:56px auto 0;padding:20px 22px 40px;border-top:3px solid var(--ink);text-align:center;font-size:.8rem;color:var(--ink-3)}

  /* ---- DB Security: code-first component set ---- */
  .sec-tag{flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;background:var(--sage);color:#fff;font-family:var(--mono);font-size:.78rem;font-weight:800}

  .filecard{background:var(--ink);color:var(--paper);border-radius:14px;overflow:hidden;box-shadow:var(--shadow)}
  .filecard .fc-head{display:flex;align-items:center;gap:9px;padding:10px 16px;background:rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.08)}
  .filecard .fc-dots{display:flex;gap:5px}
  .filecard .fc-dots span{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.22)}
  .filecard .fc-name{font-family:var(--mono);font-size:.76rem;color:rgba(255,255,255,.7);margin-left:3px}
  .filecard pre{margin:0;padding:16px 18px;font-family:var(--mono);font-size:.81rem;line-height:1.7;overflow-x:auto;white-space:pre;color:var(--paper)}
  .filecard code{background:none;padding:0;color:inherit}
  .fc-tag{color:var(--syn-tag)}
  .fc-attr{color:var(--syn-attr)}
  .fc-str{color:var(--syn-str)}
  .fc-cm{color:var(--syn-cm);font-style:italic}
  .fc-blank{color:var(--paper);background:rgba(255,255,255,.14);border-radius:3px;padding:0 4px}
  .filecard .notes{background:var(--card);color:var(--ink);padding:14px 18px;border-top:1px solid rgba(255,255,255,.1)}
  .filecard .notes ol{margin:0;padding-left:18px;font-size:.86rem;color:var(--ink-2)}
  .filecard .notes li{margin-bottom:6px}
  .filecard .notes li:last-child{margin-bottom:0}
  .filecard .notes b,.filecard .notes code{color:var(--ink)}

  .attack-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0;border-radius:14px;overflow:hidden;box-shadow:var(--shadow)}
  .af-step{padding:18px 20px}
  .af-step .af-label{display:block;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:800;margin-bottom:8px}
  .af-step h4{margin:0 0 6px;font-size:.98rem;color:var(--ink)}
  .af-step p{margin:0;font-size:.86rem;color:var(--ink-2)}
  .af-attack{background:var(--coral-soft)}
  .af-attack .af-label{color:var(--coral)}
  .af-risk{background:var(--gold-soft)}
  .af-risk .af-label{color:var(--gold)}
  .af-fix{background:var(--fwd-soft)}
  .af-fix .af-label{color:var(--fwd)}

  .flow{position:relative;padding-left:36px}
  .flow::before{content:"";position:absolute;left:10px;top:6px;bottom:6px;width:2px;background:var(--rule)}
  .flow-step{position:relative;padding-bottom:22px}
  .flow-step:last-child{padding-bottom:0}
  .flow-step::before{content:attr(data-n);position:absolute;left:-36px;top:0;width:23px;height:23px;border-radius:50%;background:var(--sage);color:#fff;font-family:var(--mono);font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center}
  .flow-step h4{margin:0 0 4px;font-size:.95rem}
  .flow-step p{margin:0;font-size:.86rem;color:var(--ink-2)}
  .flow-step .fs-code{display:block;margin-top:8px;font-family:var(--mono);font-size:.78rem;background:var(--paper-2);padding:8px 10px;border-radius:8px;color:var(--ink);overflow-x:auto;white-space:pre}

  .drill{background:var(--card);border:1.5px dashed var(--rule);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow)}
  .drill .dr-label{display:inline-block;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:var(--sage);margin-bottom:10px}
  .drill h4{margin:0 0 12px;font-size:1rem}
  .drill .match-row{display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-bottom:1px dashed var(--rule-soft);font-size:.9rem}
  .drill .match-row:last-of-type{border-bottom:none}
  .drill .match-row .blank{color:var(--ink-3);font-family:var(--mono)}
  .drill details{margin-top:12px}
  .drill summary{cursor:pointer;font-size:.85rem;font-weight:700;color:var(--sage);list-style:none}
  .drill summary::-webkit-details-marker{display:none}
  .drill summary::before{content:"▸ "}
  .drill details[open] summary::before{content:"▾ "}
  .drill .answer{margin-top:10px;padding-top:10px;border-top:1px solid var(--rule-soft);font-size:.86rem;color:var(--ink-2)}
  .drill .answer code{color:var(--ink)}

  /* ---- terminology tooltip ---- */
  .term{
    font:inherit;color:inherit;background:none;border:none;padding:0;margin:0;cursor:help;
    text-decoration:underline;text-decoration-style:dotted;text-decoration-color:var(--ink-3);
    text-underline-offset:3px;
  }
  .term:hover,.term[aria-expanded="true"]{color:var(--coral);text-decoration-color:var(--coral)}
  .term:focus-visible{outline:2px solid var(--coral);outline-offset:2px;border-radius:2px}

  .term-tooltip{
    position:absolute;z-index:50;max-width:300px;
    background:var(--ink);color:var(--paper);
    border-radius:10px;padding:12px 14px;
    font-size:.85rem;line-height:1.55;
    box-shadow:0 8px 24px rgba(0,0,0,.18);
  }
  .term-tooltip strong{display:inline;font-size:.92rem;font-weight:800}
  .term-tooltip .term-full{display:block;font-size:.74rem;color:var(--ink-3);margin:1px 0 6px;font-family:var(--mono)}
  .term-tooltip p{margin:0;color:var(--paper)}
</style>
