---
import "../fonts.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Internetwork Course" } = Astro.props;
---

<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
  <title>{title} · Internetwork Course</title>
</head>
<body>
  <div class="shell">
    <Sidebar />
    <main>
      <slot />
    </main>
    <aside class="toc" id="toc">
      <p class="toc-label">ในหน้านี้</p>
      <ul id="toc-list"></ul>
    </aside>
  </div>

  <script>
    function slugify(text) {
      return text
        .trim()
        .toLowerCase()
        .replace(/[^฀-๿a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function buildToc() {
      const heads = Array.from(document.querySelectorAll("main .sec-head h2"));
      const tocEl = document.getElementById("toc");
      const listEl = document.getElementById("toc-list");
      if (!heads.length || !tocEl || !listEl) {
        tocEl && (tocEl.style.display = "none");
        return;
      }
      listEl.innerHTML = "";
      const used = new Set();
      heads.forEach((h) => {
        let id = slugify(h.textContent || "");
        let n = 1;
        while (used.has(id) || !id) { id = `${id || "sec"}-${n++}`; }
        used.add(id);
        h.id = id;
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = h.textContent;
        a.dataset.target = id;
        li.appendChild(a);
        listEl.appendChild(li);
      });

      const links = Array.from(listEl.querySelectorAll("a"));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = links.find((l) => l.dataset.target === entry.target.id);
            if (!link) return;
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove("active"));
              link.classList.add("active");
            }
          });
        },
        { rootMargin: "-10% 0px -70% 0px" }
      );
      heads.forEach((h) => observer.observe(h));
    }

    buildToc();
  </script>
</body>
</html>

<style is:global>
  :root{
    --paper:#FFFFFF; --paper-2:#F3F4F6; --card:#FFFFFF;
    --ink:#14161A; --ink-2:#565D6B; --ink-3:#8A93A3;
    --rule:#E1E4EA; --rule-soft:#ECEEF2;
    --coral:#D8542E; --coral-soft:#FCEAE3;
    --slate:#2E6C8E; --slate-soft:#E7F1F7;
    --gold:#9C6C08; --gold-soft:#FBF1DC;
    --violet:#6647C2; --violet-soft:#EFE9FB;
    --fwd:#1F8F5F; --blk:#C6362E;
    --shadow:0 1px 2px rgba(20,22,26,.04), 0 6px 16px rgba(20,22,26,.06);
    --sans:'Sarabun',"Leelawadee UI","Segoe UI",system-ui,-apple-system,sans-serif;
    --serif:Georgia,"Times New Roman",serif;
    --mono:"Cascadia Mono",Consolas,ui-monospace,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.65;font-size:15.5px}
  .shell{display:flex;align-items:flex-start}
  main{flex:1;min-width:0;max-width:760px;margin:0 auto;padding:24px 32px 80px}
  .toc{
    width:220px;flex:none;position:sticky;top:0;height:100vh;overflow-y:auto;
    padding:24px 18px;
  }
  .toc-label{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--ink-3);margin:0 0 10px}
  .toc ul{list-style:none;margin:0;padding:0;border-left:1px solid var(--rule-soft)}
  .toc li{margin:0}
  .toc a{
    display:block;text-decoration:none;color:var(--ink-3);font-size:.82rem;
    padding:5px 0 5px 14px;border-left:2px solid transparent;margin-left:-1px;
    line-height:1.4;
  }
  .toc a:hover{color:var(--ink-2)}
  .toc a.active{color:var(--coral);border-left-color:var(--coral);font-weight:700}
  @media (max-width:1200px){ .toc{display:none} }
  @media (max-width:860px){
    .shell{flex-direction:column}
    main{max-width:100%;padding:24px 22px 80px}
  }

  /* ---- masthead ---- */
  .masthead{text-align:left;padding-bottom:22px;border-bottom:1px solid var(--rule-soft);margin-bottom:8px}
  .masthead .eyebrow{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;margin:0 0 12px}
  .masthead h1{font-family:var(--sans);font-size:clamp(1.7rem,4.4vw,2.5rem);font-weight:800;letter-spacing:-.02em;margin:0 0 12px;text-wrap:balance;line-height:1.15}
  .masthead .deck{margin:0;max-width:68ch;color:var(--ink-2);font-size:1rem}
  .credit-bar{display:flex;justify-content:flex-start;gap:8px;flex-wrap:wrap;padding:14px 0 0;font-size:.78rem;color:var(--ink-3)}
  .credit-bar span{background:var(--paper-2);border:1px solid var(--rule-soft);padding:3px 12px;border-radius:6px;font-family:var(--mono);font-size:.72rem}

  section{margin-top:40px}
  .sec-head{display:flex;align-items:center;gap:12px;margin-bottom:6px}
  .sec-head .mark{flex:none;margin:0}
  .sec-head h2{margin:0;font-size:1.1rem;font-weight:800;letter-spacing:-.01em;scroll-margin-top:20px}
  .sec-sub{margin:0 0 18px 38px;color:var(--ink-2);font-size:.93rem;max-width:74ch}
  @media (max-width:600px){ .sec-sub{margin-left:0} }

  .grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
  .grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}

  .card{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:18px 20px;box-shadow:var(--shadow)}
  .card h3{margin:0 0 10px;font-size:.95rem;font-weight:800}
  .card ul{margin:0;padding-left:18px;color:var(--ink-2);font-size:.9rem}
  .card ul li{margin-bottom:7px}
  .card ul li:last-child{margin-bottom:0}
  .card ul li b{color:var(--ink)}

  code{font-family:var(--mono);font-size:.86em;background:var(--paper-2);padding:1px 5px;border-radius:4px;color:var(--coral)}

  figure{margin:0}
  .figwrap{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:18px;box-shadow:var(--shadow);overflow-x:auto}
  svg{display:block;max-width:100%;height:auto}
  .figwrap svg{margin:0 auto}
  figcaption{margin-top:12px;font-size:.85rem;color:var(--ink-3);text-align:center;max-width:78ch;margin-left:auto;margin-right:auto}

  .pathway{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:0}
  .pw-step{position:relative;background:var(--card);border:1px solid var(--rule-soft);padding:14px 16px}
  .pw-step:first-child{border-radius:10px 0 0 10px}
  .pw-step:last-child{border-radius:0 10px 10px 0}
  .pw-step + .pw-step{border-left:none}
  @media (max-width:840px){ .pw-step,.pw-step:first-child,.pw-step:last-child{border-radius:10px;margin-bottom:8px;border-left:1px solid var(--rule-soft)} }
  .pw-step .n{font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.1em;display:block;margin-bottom:6px}
  .pw-step h4{margin:0 0 6px;font-size:.9rem;font-weight:800}
  .pw-step p{margin:0;font-size:.83rem;color:var(--ink-2)}

  .cascade{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
  .rung{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:14px 16px;box-shadow:var(--shadow);border-top:2px solid var(--coral)}
  .rung .step-n{font-family:var(--mono);font-size:1.3rem;font-weight:800;line-height:1;color:var(--coral);display:block;margin-bottom:6px}
  .rung h4{margin:0 0 4px;font-size:.92rem;font-weight:800}
  .rung .what{margin:0 0 10px;font-size:.83rem;color:var(--ink-2)}
  .rung .lab{font-size:.8rem;background:var(--paper-2);border-radius:6px;padding:8px 10px;color:var(--ink-2)}
  .rung .lab b{color:var(--ink)}

  .inst-card{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:16px;box-shadow:var(--shadow)}
  .inst-card .head{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:2px}
  .inst-card h4{margin:0;font-family:var(--mono);font-size:.98rem;font-weight:700}
  .inst-card .vl{font-size:.76rem;color:var(--ink-3);font-family:var(--mono)}
  .inst-card .rootline{font-size:.83rem;color:var(--ink-2);margin:0 0 10px}
  .inst-card .rootline b{color:var(--ink)}
  .inst-card .result{margin:10px 0 0;font-size:.8rem;font-family:var(--mono);padding-top:10px;border-top:1px dashed var(--rule);color:var(--ink-2)}
  .inst-card .result b{color:var(--ink)}

  .knob{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:16px 18px;box-shadow:var(--shadow)}
  .knob .where{display:inline-block;font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;padding:2px 9px;border-radius:6px;margin-bottom:8px}
  .knob .where.c1{color:var(--coral);background:var(--coral-soft)}
  .knob .where.c2{color:var(--gold);background:var(--gold-soft)}
  .knob .where.c3{color:var(--violet);background:var(--violet-soft)}
  .knob h3{margin:0 0 4px;font-size:.95rem}
  .knob .why{margin:0 0 14px;font-size:.85rem;color:var(--ink-2)}
  .knob pre{margin:0 0 12px;font-family:var(--mono);font-size:.76rem;background:#0B0D12;padding:10px 12px;border-radius:8px;overflow-x:auto;color:#E8EAF0;white-space:pre-wrap;border:1px solid var(--rule-soft)}
  .knob .out{font-family:var(--mono);font-size:.72rem;background:#0B0D12;color:#7EE8A8;padding:9px 11px;border-radius:8px;overflow-x:auto;margin:0;white-space:pre;border:1px solid var(--rule-soft)}

  table{width:100%;border-collapse:collapse;font-size:.88rem}
  caption{text-align:left;font-weight:800;padding-bottom:10px;font-size:.98rem}
  th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--rule-soft);vertical-align:top}
  thead th{font-family:var(--mono);font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3);border-bottom:1px solid var(--rule)}
  tbody th{font-family:var(--mono);font-weight:700;font-size:.8rem;white-space:nowrap;color:var(--ink)}
  td{color:var(--ink-2)}
  .tablewrap{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:18px 20px;box-shadow:var(--shadow);overflow-x:auto}
  td.center{text-align:center;font-family:var(--mono)}

  .exam{background:var(--card);border:1px solid var(--rule-soft);border-radius:10px;padding:16px 18px;box-shadow:var(--shadow);border-left:3px solid var(--gold)}
  .exam h4{margin:0 0 8px;font-size:.92rem;display:flex;align-items:center;gap:8px}
  .exam .tag{font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--gold);border:1px solid var(--gold);border-radius:6px;padding:1px 7px;white-space:nowrap}
  .exam p{margin:0 0 8px;font-size:.85rem;color:var(--ink-2)}
  .exam p:last-child{margin-bottom:0}

  .fixnote{margin-top:18px;border-radius:10px;padding:14px 18px;font-size:.87rem;color:var(--ink);border:1px solid var(--rule-soft)}
  .fixnote b{color:inherit}

  .bridge{background:var(--violet-soft);border-radius:10px;padding:16px 20px;font-size:.9rem;color:var(--ink);border:1px solid var(--rule-soft)}
  .bridge b{color:var(--violet)}

  footer{max-width:1180px;margin:48px auto 0;padding:18px 22px 40px;border-top:1px solid var(--rule-soft);text-align:left;font-size:.78rem;color:var(--ink-3);font-family:var(--mono)}
</style>
