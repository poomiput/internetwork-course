            <text x="1000" y="150" text-anchor="middle" font-size="9.5" fill="var(--ink-2)">native VLAN 999</text>

            <rect x="870" y="152" width="150" height="55" rx="4" fill="var(--card)" stroke="var(--ink-2)" stroke-width="2"/>
            <text x="945" y="177" text-anchor="middle" font-size="14" font-weight="700" fill="var(--ink)">D2</text>
            <text x="945" y="195" text-anchor="middle" font-size="9.5" fill="var(--ink-2)">แค่ trunk ส่งผ่าน</text>

            <line x1="905" y1="207" x2="870" y2="250" stroke="var(--ink-2)" stroke-width="2"/>
            <line x1="985" y1="207" x2="1020" y2="250" stroke="var(--ink-2)" stroke-width="2"/>

            <rect x="820" y="252" width="100" height="42" rx="4" fill="var(--card)" stroke="var(--coral)" stroke-width="1.6"/>
