            <line x1="330" y1="120" x2="330" y2="160" stroke="var(--ink-3)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#pv-t-arrow)"/>
            <text x="270" y="145" font-size="11.5" fill="var(--ink)" font-weight="700">D1 route เองบนตัวมันเอง</text>
            <text x="270" y="162" font-size="10.5" fill="var(--ink-2)">ไม่ต้องมี router แยก</text>

            <line x1="700" y1="120" x2="700" y2="160" stroke="var(--ink-3)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#pv-t-arrow)"/>
            <text x="700" y="140" font-size="11.5" fill="var(--ink)" font-weight="700" text-anchor="middle">R1 = จุดเชื่อมกลาง</text>
            <text x="700" y="160" font-size="10.5" fill="var(--ink-2)" text-anchor="middle">รู้เส้นทางทั้งสองฝั่ง</text>

