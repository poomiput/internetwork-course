---
import PreviewLayout from "../layouts/PreviewLayout.astro";

const ruler = ["0x00", "0x04", "0x08", "0x0C", "0x10", "0x14", "0x18", "0x1C"];
---
<PreviewLayout title="Packet Forwarding Anatomy" description="ดีไซน์พรีวิว — Chapter 1 ในทิศทางภาพ &quot;packet header&quot; ใหม่ ยังไม่แตะเว็บจริง">

  <div class="pv-shell">

    <header class="pv-hero">
      <div class="pv-ruler" aria-hidden="true">
        {ruler.map((tick) => <span>{tick}</span>)}
      </div>
      <div class="pv-field">
        <span class="pv-field-label">chapter · packet-forwarding</span>
        <h1>Packet Forwarding &amp; Inter-VLAN Routing</h1>
        <p class="pv-deck">VLAN ตัดขาด Broadcast Domain ได้ดีมาก ดีจนสอง VLAN คุยกันเองไม่ได้เลย — บทนี้คือเรื่องของการเอา Layer 3 กลับเข้ามาเชื่อม และกลไกที่ทำให้ส่งแพ็กเก็ตได้เร็วที่สุดโดยไม่ต้องพึ่ง CPU ทุกครั้ง</p>
        <div class="pv-credit-bar">
          <span class="pv-chip">R1 · R3 · D1 · D2 · PC1-4</span>
          <span class="pv-chip">Cisco IOS XE 16.9.4</span>
          <span class="pv-chip">Router-on-a-Stick</span>
          <span class="pv-chip">Layer 3 Switch</span>
          <span class="pv-chip">CEF</span>
        </div>
      </div>
    </header>

    <section class="pv-section">
      <div class="pv-sec-head">
        <span class="pv-offset">0x00</span>
        <h2>โจทย์ตั้งต้น</h2>
      </div>
      <div class="pv-grid-2">
        <div class="pv-card">
          <h3>ปัญหาของ VLAN</h3>
          <ul>
            <li><b>Collision Domain</b> = ขอบเขตที่เฟรมชนกันได้ — Hub กระจายทุกพอร์ต (โดนชนได้หมด) ส่วน Switch แบ่งขอบเขตให้เล็กลงทีละพอร์ต</li>
            <li><b>Broadcast Domain</b> = ขอบเขตที่ Broadcast กระจายถึง — ปกติต้องใช้ Router ตัดเท่านั้น แต่ <b>VLAN (IEEE 802.1Q)</b> ตัดได้โดยไม่ต้องมี Router เลย ด้วยการแปะ tag บอกที่มา</li>
            <li>ปัญหาที่ตามมา: พอ VLAN ตัด Broadcast Domain เก่งขนาดนี้ <b>สอง VLAN ก็คุยกันเองไม่ได้เลย</b> — ต้องดึง Layer 3 กลับเข้ามาช่วย route ระหว่าง VLAN</li>
          </ul>
        </div>
        <div class="pv-card">
          <h3>สิ่งที่แลปนี้สร้าง — สองวิธีแก้โจทย์เดียวกัน</h3>
          <ul>
            <li><b>D1</b> เป็น Layer 3 Switch: สร้าง VLAN 50, 60 + SVI แล้ว route เองบนตัวมันเอง ไม่ต้องมี router แยก</li>
            <li><b>D2 + R3</b> เป็นคู่ Router-on-a-Stick: D2 ทำหน้าที่แค่ trunk ส่ง VLAN 75, 85 ผ่านสายเดียวไปให้ R3 เป็นคน route ผ่าน subinterface</li>
            <li><b>R1</b> อยู่ตรงกลางเชื่อมทั้งสองฝั่งเข้าด้วยกันด้วย static route</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="pv-section">
      <div class="pv-sec-head">
        <span class="pv-offset">0x04</span>
        <h2>กายวิภาคของ Topology</h2>
      </div>
      <p class="pv-sec-sub">สองปีกซ้าย-ขวาที่ต่างวิธีแก้โจทย์เดียวกัน มาบรรจบกันที่ R1 ตรงกลาง</p>

