            <text x="792" y="258" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">Adjacency Table</text>
            <text x="792" y="276" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">มาจาก ARP Table</text>
