          <figcaption>ฝั่งซ้าย: routing เกิด "ข้างใน" ตัวสวิตช์ (D1) — ฝั่งขวา: routing เกิด "ที่ปลายสาย" บนเราเตอร์แยก (R3) โดยแบ่ง VLAN ด้วย subinterface หนึ่งเดียวต่อสายกายภาพหนึ่งเส้น</figcaption>
        </figure>
      </div>
    </section>

    <section class="pv-section">
      <div class="pv-sec-head">
        <span class="pv-offset">0x08</span>
        <h2>เฟรมมาถึง ตัดสินใจยังไง</h2>
      </div>
      <p class="pv-sec-sub">คำถามเดียวตัดสินทุกอย่าง: "ปลายทางอยู่ VLAN/Subnet เดียวกันไหม" — ถ้าใช่ อ่าน MAC Table จบเลย ถ้าไม่ใช่ ต้องพึ่ง Layer 3 และใช้เส้นทางลัดที่ชื่อ CEF</p>

      <div class="pv-figwrap">
        <figure>
          <svg viewBox="0 0 1040 440" role="img" aria-label="แผนผังการตัดสินใจส่งเฟรม: เฟรมเข้ามาที่สวิตช์ ถามว่าปลายทางอยู่ VLAN เดียวกันไหม ถ้าใช่อ่าน MAC Address Table แล้วส่งตรงไปพอร์ตปลายทางเป็น Layer 2 ล้วน ถ้าไม่ใช่ต้องส่งผ่าน Router หรือ SVI ซึ่งจะเช็ค ARP Table หา MAC ปลายทาง แล้วใช้ CEF ประกอบด้วย FIB ตารางเส้นทาง Layer 3 และ Adjacency Table ที่เก็บ Layer 2 header สำเร็จรูปไว้แล้ว ส่งออกได้ทันทีโดยไม่ต้องผ่าน CPU ประมวลผลใหม่ทุกครั้ง">
            <defs>
              <marker id="pv-fw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-3)"/>
              </marker>
            </defs>

            <rect x="20" y="20" width="130" height="52" rx="4" fill="var(--paper-2)" stroke="var(--ink-2)" stroke-width="2"/>
            <text x="85" y="52" text-anchor="middle" font-size="14" font-weight="700" fill="var(--ink)">เฟรมเข้ามา</text>

            <line x1="150" y1="46" x2="158" y2="46" stroke="var(--ink-3)" stroke-width="2" marker-end="url(#pv-fw-arrow)"/>

            <polygon points="300,10 440,46 300,82 160,46" fill="var(--paper-2)" stroke="var(--ink-2)" stroke-width="2"/>
            <text x="300" y="42" text-anchor="middle" font-size="12.5" fill="var(--ink)" font-weight="700">ปลายทาง</text>
            <text x="300" y="58" text-anchor="middle" font-size="12.5" fill="var(--ink)" font-weight="700">VLAN เดียวกัน?</text>

            <line x1="300" y1="83" x2="300" y2="138" stroke="var(--fwd)" stroke-width="2.2" marker-end="url(#pv-fw-arrow)"/>
            <text x="330" y="115" font-size="12" fill="var(--fwd)" font-weight="700">ใช่</text>

            <rect x="230" y="140" width="140" height="46" rx="4" fill="var(--slate-soft)" stroke="var(--slate)" stroke-width="2"/>
            <text x="300" y="167" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">MAC Address Table</text>

            <line x1="300" y1="186" x2="300" y2="220" stroke="var(--fwd)" stroke-width="2.2" marker-end="url(#pv-fw-arrow)"/>
            <rect x="185" y="222" width="230" height="46" rx="4" fill="var(--card)" stroke="var(--fwd)" stroke-width="2"/>
            <text x="300" y="250" text-anchor="middle" font-size="12" font-weight="700" fill="var(--fwd)">ส่งตรงไปพอร์ตปลายทาง (L2 ล้วน)</text>

            <line x1="440" y1="46" x2="468" y2="46" stroke="var(--coral)" stroke-width="2.2" marker-end="url(#pv-fw-arrow)"/>
            <text x="452" y="34" font-size="12" fill="var(--coral)" font-weight="700">ไม่ใช่</text>

            <rect x="470" y="20" width="190" height="52" rx="4" fill="var(--coral-soft)" stroke="var(--coral)" stroke-width="2"/>
            <text x="565" y="45" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--ink)">ต้องผ่าน L3</text>
            <text x="565" y="61" text-anchor="middle" font-size="11" fill="var(--ink-2)">Router หรือ SVI</text>

            <line x1="565" y1="72" x2="565" y2="106" stroke="var(--coral)" stroke-width="2.2" marker-end="url(#pv-fw-arrow)"/>
            <rect x="470" y="108" width="190" height="46" rx="4" fill="var(--card)" stroke="var(--ink-2)" stroke-width="2"/>
            <text x="565" y="136" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">เช็ค ARP Table หา MAC</text>

            <line x1="565" y1="154" x2="565" y2="188" stroke="var(--coral)" stroke-width="2.2" marker-end="url(#pv-fw-arrow)"/>

            <rect x="440" y="190" width="480" height="200" rx="4" fill="var(--gold-soft)" stroke="var(--gold)" stroke-width="2"/>
            <text x="680" y="215" text-anchor="middle" font-size="13" font-weight="700" fill="var(--gold)">CEF — เส้นทางลัด ไม่ผ่าน CPU ซ้ำ</text>

            <rect x="465" y="235" width="200" height="130" rx="4" fill="var(--card)" stroke="var(--gold)" stroke-width="1.6"/>
            <text x="565" y="258" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">FIB</text>
            <text x="565" y="276" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">Forwarding Info Base</text>
            <text x="565" y="298" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">มาจาก Routing Table</text>
