          <rect x="250" y="70" width="300" height="130" rx="10" fill="var(--gold-soft)" stroke="var(--gold)" stroke-width="2"/>
          <text x="400" y="60" text-anchor="middle" font-size="13" font-weight="700" fill="var(--gold)">Area 0 — Backbone</text>

          <rect x="45" y="110" width="90" height="46" rx="8" fill="var(--card)" stroke="var(--ink-2)" stroke-width="1.8"/>
