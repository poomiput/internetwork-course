          <text x="570" y="200" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)">D2</text>
          <line x1="580" y1="110" x2="610" y2="170" stroke="var(--fwd)" stroke-width="3"/>
          <line x1="560" y1="110" x2="530" y2="170" stroke="var(--fwd)" stroke-width="3"/>
          <rect x="530" y="128" width="80" height="24" rx="6" fill="var(--coral-soft)" stroke="var(--coral)" stroke-width="1.5"/>
