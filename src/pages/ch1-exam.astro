  <style>
    .score-bar{
      position:sticky;top:0;z-index:5;
      display:flex;align-items:center;gap:18px;flex-wrap:wrap;
      background:var(--slate-soft);border:1px solid var(--slate);border-radius:12px;
      padding:12px 18px;margin:0 0 24px;font-size:.88rem;color:var(--ink);
    }
    .score-bar b{font-family:var(--mono);color:var(--slate);font-size:1rem}
    .score-bar button{
      margin-left:auto;border:1px solid var(--slate);background:var(--card);color:var(--slate);
      font-family:var(--sans);font-size:.82rem;font-weight:700;padding:6px 14px;border-radius:999px;
      cursor:pointer;transition:background .15s;
    }
    .score-bar button:hover{background:var(--slate);color:#fff}

    .mcq{border:1px solid var(--rule-soft);border-radius:14px;padding:22px 24px;margin-bottom:14px;background:var(--card)}
    .mcq-n{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);font-weight:700;margin:0 0 8px}
    .mcq-q{margin:0 0 12px;font-size:.98rem;color:var(--ink);font-weight:600;line-height:1.6}
    .mcq-opts{list-style:none;margin:0 0 4px;padding:0;display:flex;flex-direction:column;gap:7px}
    .mcq-opts li{padding:8px 12px;border:1px solid var(--rule-soft);border-radius:8px;font-size:.9rem;color:var(--ink-2);cursor:pointer;transition:border-color .12s, background .12s, transform .1s}
    .mcq-opts li:hover{border-color:var(--slate);transform:translateX(2px)}
    .mcq-opts li b{font-family:var(--mono);color:var(--slate);margin-right:8px}
    .mcq[data-locked="1"] .mcq-opts li{cursor:default}
    .mcq[data-locked="1"] .mcq-opts li:hover{transform:none}
    .mcq-opts li.is-correct{border-color:var(--fwd);background:var(--fwd-soft);color:var(--ink)}
    .mcq-opts li.is-correct b{color:var(--fwd)}
    .mcq-opts li.is-wrong{border-color:var(--coral);background:var(--coral-soft);color:var(--ink)}
    .mcq-opts li.is-wrong b{color:var(--coral)}
    .mcq details{margin-top:12px}
    .mcq summary{cursor:pointer;color:var(--slate);font-weight:700;font-size:.85rem;list-style:none}
    .mcq summary::-webkit-details-marker{display:none}
    .mcq summary::before{content:"▸ "}
    .mcq details[open] summary::before{content:"▾ "}
    .mcq-answer{margin-top:10px;padding-top:10px;border-top:1px dashed var(--rule);font-size:.88rem;color:var(--ink-2);line-height:1.6}
    .mcq-answer b{color:var(--fwd)}

    @media (max-width:640px){
      .score-bar{gap:10px 16px}
      .score-bar button{margin-left:0}
    }
  </style>

  <script>
    (function () {
      const doneEl = document.getElementById("scoreDone");
      const correctEl = document.getElementById("scoreCorrect");
      const resetBtn = document.getElementById("resetMock");
      let done = 0;
      let correct = 0;

      function updateScore() {
        if (doneEl) doneEl.textContent = String(done);
        if (correctEl) correctEl.textContent = String(correct);
      }

      document.querySelectorAll(".mcq[data-answer]").forEach((mcq) => {
        const answer = mcq.getAttribute("data-answer");
        mcq.querySelectorAll(".mcq-opts li").forEach((li) => {
          li.addEventListener("click", () => {
            if (mcq.getAttribute("data-locked") === "1") return;
            mcq.setAttribute("data-locked", "1");

            const letter = li.getAttribute("data-letter");
            const isCorrect = letter === answer;
            li.classList.add(isCorrect ? "is-correct" : "is-wrong");

            if (!isCorrect) {
              const correctLi = mcq.querySelector('.mcq-opts li[data-letter="' + answer + '"]');
              if (correctLi) correctLi.classList.add("is-correct");
            }

            const details = mcq.querySelector("details");
            if (details) details.open = true;

            done += 1;
            if (isCorrect) correct += 1;
            updateScore();
          });
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener("click", () => location.reload());
      }
    })();
  </script>

