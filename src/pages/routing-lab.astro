    /* ============================================================
       RENDERER
       ============================================================ */

    var NS = "http://www.w3.org/2000/svg";
    var current = PROTOCOLS[0];
    var index = 0;
    var timer = null;
    var PLAY_MS = 2400;

    var elCanvas = document.getElementById("rl-canvas");
    var elDesc = document.getElementById("rl-desc");
    var elState = document.getElementById("rl-state");
    var elDots = document.getElementById("rl-dots");
    var elName = document.getElementById("rl-name");
    var elChap = document.getElementById("rl-chap");
    var elCounter = document.getElementById("rl-counter");
    var elPicker = document.getElementById("rl-picker");
    var btnPlay = document.getElementById("rl-play");
    var btnPrev = document.getElementById("rl-prev");
    var btnNext = document.getElementById("rl-next");
    var btnReset = document.getElementById("rl-reset");

    function nodeById(proto, id) {
      for (var i = 0; i < proto.nodes.length; i++) {
        if (proto.nodes[i].id === id) return proto.nodes[i];
      }
      return null;
    }

    /* Draw one link as a path, optionally bowed out by `bend` so
       parallel links between the same pair stay visually distinct. */
    function linkPath(proto, link) {
      var a = nodeById(proto, link.a);
      var b = nodeById(proto, link.b);
      if (!a || !b) return { d: "", mx: 0, my: 0 };
      var mx = (a.x + b.x) / 2;
      var my = (a.y + b.y) / 2;
      if (!link.bend) {
        return { d: "M " + a.x + " " + a.y + " L " + b.x + " " + b.y, mx: mx, my: my };
      }
      var dx = b.x - a.x, dy = b.y - a.y;
      var len = Math.sqrt(dx * dx + dy * dy) || 1;
      var ox = (-dy / len) * link.bend;
      var oy = (dx / len) * link.bend;
      var cx = mx + ox * 2, cy = my + oy * 2;
      return {
        d: "M " + a.x + " " + a.y + " Q " + cx + " " + cy + " " + b.x + " " + b.y,
        mx: mx + ox, my: my + oy
      };
    }

    function buildSVG(proto) {
      var svg = document.createElementNS(NS, "svg");
      svg.setAttribute("viewBox", proto.viewBox);
      svg.setAttribute("role", "img");
      svg.setAttribute("aria-label", "ผังจำลองการทำงานของ " + proto.label);

      var gLinks = document.createElementNS(NS, "g");
      var gLabels = document.createElementNS(NS, "g");
      var gNodes = document.createElementNS(NS, "g");
      var gPkts = document.createElementNS(NS, "g");
      gPkts.setAttribute("id", "rl-pkts");

      proto.links.forEach(function (link) {
        var geo = linkPath(proto, link);
        var p = document.createElementNS(NS, "path");
        p.setAttribute("d", geo.d);
        p.setAttribute("class", "rl-link");
        p.setAttribute("data-link", link.id);
        gLinks.appendChild(p);

        if (link.label) {
          var t = document.createElementNS(NS, "text");
          t.setAttribute("x", geo.mx);
          t.setAttribute("y", geo.my - 6);
          t.setAttribute("text-anchor", "middle");
          t.setAttribute("class", "rl-linklabel");
          t.setAttribute("data-linklabel", link.id);
          t.textContent = link.label;
          gLabels.appendChild(t);
        }
      });

      proto.nodes.forEach(function (n) {
        var g = document.createElementNS(NS, "g");
        if (n.kind === "net") {
          var rx = n.r || 30;
          var el = document.createElementNS(NS, "ellipse");
          el.setAttribute("cx", n.x);
          el.setAttribute("cy", n.y);
          el.setAttribute("rx", rx);
          el.setAttribute("ry", 24);
          el.setAttribute("class", "rl-nodebox");
          el.setAttribute("data-node", n.id);
          g.appendChild(el);
        } else {
          var w = 84, h = 48;
          var r = document.createElementNS(NS, "rect");
          r.setAttribute("x", n.x - w / 2);
          r.setAttribute("y", n.y - h / 2);
          r.setAttribute("width", w);
          r.setAttribute("height", h);
          r.setAttribute("rx", 9);
          r.setAttribute("class", "rl-nodebox");
          r.setAttribute("data-node", n.id);
          g.appendChild(r);
        }
        var lbl = document.createElementNS(NS, "text");
        lbl.setAttribute("x", n.x);
        lbl.setAttribute("y", n.sub ? n.y - 2 : n.y + 4);
        lbl.setAttribute("text-anchor", "middle");
        lbl.setAttribute("class", "rl-nodelabel");
        lbl.textContent = n.label;
        g.appendChild(lbl);

        if (n.sub) {
          var sub = document.createElementNS(NS, "text");
          sub.setAttribute("x", n.x);
          sub.setAttribute("y", n.y + 13);
          sub.setAttribute("text-anchor", "middle");
          sub.setAttribute("class", "rl-nodesub");
          sub.textContent = n.sub;
          g.appendChild(sub);
        }
        gNodes.appendChild(g);
      });

      svg.appendChild(gLinks);
      svg.appendChild(gLabels);
      svg.appendChild(gNodes);
      svg.appendChild(gPkts);
      return svg;
    }

    function clearPackets() {
      var host = elCanvas.querySelector("#rl-pkts");
      if (host) host.textContent = "";
    }

    function spawnPacket(proto, spec) {
      var a = nodeById(proto, spec.f);
      var b = nodeById(proto, spec.t);
      var host = elCanvas.querySelector("#rl-pkts");
      if (!a || !b || !host) return;

      var g = document.createElementNS(NS, "g");
      g.setAttribute("class", "rl-pkt");
      g.style.transform = "translate(" + a.x + "px," + a.y + "px)";

      if (spec.label) {
        var w = Math.max(26, String(spec.label).length * 7 + 12);
        var rect = document.createElementNS(NS, "rect");
        rect.setAttribute("x", -w / 2);
        rect.setAttribute("y", -9);
        rect.setAttribute("width", w);
        rect.setAttribute("height", 18);
        rect.setAttribute("rx", 9);
        rect.setAttribute("class", "rl-pkt-body");
        g.appendChild(rect);
        var t = document.createElementNS(NS, "text");
        t.setAttribute("class", "rl-pkt-text");
        t.setAttribute("y", 1);
        t.textContent = spec.label;
        g.appendChild(t);
      } else {
        var c = document.createElementNS(NS, "circle");
        c.setAttribute("r", 8);
        c.setAttribute("class", "rl-pkt-body");
        g.appendChild(c);
      }

      host.appendChild(g);
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          g.style.transform = "translate(" + b.x + "px," + b.y + "px)";
        });
      });
    }

    function renderStep(proto, i) {
      if (!proto.steps[i]) return;
      var step = proto.steps[i];

      clearPackets();

      /* links + their labels */
      var linkState = step.link || {};
      elCanvas.querySelectorAll("[data-link]").forEach(function (el) {
        var s = linkState[el.getAttribute("data-link")];
        el.setAttribute("class", "rl-link" + (s ? " is-" + s : ""));
      });
      elCanvas.querySelectorAll("[data-linklabel]").forEach(function (el) {
        var s = linkState[el.getAttribute("data-linklabel")];
        var on = s === "active" || s === "alt";
        el.setAttribute("class", "rl-linklabel" + (on ? " is-on" : ""));
      });

      /* nodes */
      var nodeState = step.node || {};
      elCanvas.querySelectorAll("[data-node]").forEach(function (el) {
        var s = nodeState[el.getAttribute("data-node")];
        el.setAttribute("class", "rl-nodebox" + (s ? " is-" + s : ""));
      });

      /* packets */
      (step.pkt || []).forEach(function (p) { spawnPacket(proto, p); });

      /* text + state table */
      elDesc.innerHTML = step.desc;

      var rows = step.state || [];
      var html = "<table><caption>" + proto.label + "</caption><thead><tr>";
      proto.stateHead.forEach(function (h) { html += "<th scope='col'>" + h + "</th>"; });
      html += "</tr></thead><tbody>";
      rows.forEach(function (r) {
        html += "<tr>";
        r.forEach(function (cell, ci) {
          html += ci === 0 ? "<th scope='row'>" + cell + "</th>" : "<td>" + cell + "</td>";
        });
        html += "</tr>";
      });
      html += "</tbody></table>";
      elState.innerHTML = html;

      /* counter + dots + button states */
      elCounter.textContent = "ขั้นที่ " + (i + 1) + " / " + proto.steps.length;
      elDots.querySelectorAll(".rl-dot").forEach(function (d, di) {
        d.setAttribute("aria-current", di === i ? "true" : "false");
      });
      btnPrev.disabled = i === 0;
      btnNext.disabled = i === proto.steps.length - 1;
    }

    function buildDots(proto) {
      elDots.textContent = "";
      proto.steps.forEach(function (s, i) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "rl-dot";
        b.setAttribute("aria-label", "ไปที่ขั้นที่ " + (i + 1));
        b.addEventListener("click", function () { stop(); go(i); });
        elDots.appendChild(b);
      });
    }

    function go(i) {
      index = Math.max(0, Math.min(current.steps.length - 1, i));
      renderStep(current, index);
      if (index === current.steps.length - 1) stop();
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
      btnPlay.textContent = "▶ เล่น";
    }

    function play() {
      if (timer) { stop(); return; }
      /* rewind immediately (and render) so the counter never lies */
      if (index >= current.steps.length - 1) { index = 0; renderStep(current, 0); }
      btnPlay.textContent = "⏸ หยุด";
      timer = setInterval(function () {
        if (index >= current.steps.length - 1) { stop(); return; }
        index += 1;
        renderStep(current, index);
      }, PLAY_MS);
    }

    function selectProto(proto) {
      stop();
      current = proto;
      index = 0;

      elPicker.querySelectorAll(".rl-chip").forEach(function (c) {
        c.setAttribute("aria-selected", c.getAttribute("data-proto") === proto.id ? "true" : "false");
      });

      document.querySelector(".rl-lab").style.setProperty("--accent", proto.accent);
      elName.textContent = proto.name;
      elChap.textContent = proto.chap;

      elCanvas.textContent = "";
      elCanvas.appendChild(buildSVG(proto));
      buildDots(proto);
      renderStep(proto, 0);
    }

    /* ---------- picker ---------- */
    (function buildPicker() {
      var groups = [];
      PROTOCOLS.forEach(function (p) {
        var g = null;
        for (var i = 0; i < groups.length; i++) if (groups[i].name === p.group) g = groups[i];
        if (!g) { g = { name: p.group, items: [] }; groups.push(g); }
        g.items.push(p);
      });

      groups.forEach(function (g) {
        var wrap = document.createElement("div");
        wrap.className = "rl-group";
        var title = document.createElement("p");
        title.className = "rl-group-title";
        title.textContent = g.name;
        wrap.appendChild(title);

        var chips = document.createElement("div");
        chips.className = "rl-group-chips";
        g.items.forEach(function (p) {
          var b = document.createElement("button");
          b.type = "button";
          b.className = "rl-chip";
          b.setAttribute("data-proto", p.id);
          b.setAttribute("aria-selected", "false");
          b.style.setProperty("--accent", p.accent);
          b.textContent = p.label;
          b.addEventListener("click", function () { selectProto(p); });
          chips.appendChild(b);
        });
        wrap.appendChild(chips);
        elPicker.appendChild(wrap);
      });
    })();

    /* ---------- controls ---------- */
    btnPrev.addEventListener("click", function () { stop(); go(index - 1); });
    btnNext.addEventListener("click", function () { stop(); go(index + 1); });
    btnReset.addEventListener("click", function () { stop(); go(0); });
    btnPlay.addEventListener("click", play);

    document.addEventListener("keydown", function (e) {
      var tag = (e.target && e.target.tagName) || "";
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (e.key === "ArrowRight") { stop(); go(index + 1); }
      else if (e.key === "ArrowLeft") { stop(); go(index - 1); }
      else if (e.key === "Home") { stop(); go(0); }
      else if (e.key === " " || e.code === "Space") {
        if (document.activeElement && document.activeElement.classList.contains("rl-btn")) return;
        e.preventDefault();
        play();
      }
    });

    /* pause autoplay when the browser tab is hidden */
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop();
    });

    selectProto(PROTOCOLS[0]);
  })();
</script>
