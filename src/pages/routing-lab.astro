  const LINK_ID: Record<string, Record<string, string>> = {
    dv: { "r1-r2": "dv-link-r1-r2", "r2-r3": "dv-link-r2-r3", "r3-net": "dv-link-r3-net" },
    eigrp: {
      "r1-r3": "eigrp-link-r1-r3", "r3-r4": "eigrp-link-r3-r4",
      "r1-r4": "eigrp-link-r1-r4", "r4-net": "eigrp-link-r4-net",
    },
    ospf: {
      "r1-r2": "ospf-link-r1-r2", "r2-r3": "ospf-link-r2-r3",
      "r3-r4": "ospf-link-r3-r4", "r4-r1": "ospf-link-r4-r1", "r1-r3": "ospf-link-r1-r3",
    },
  };

  let currentProto = "dv";
  let currentIndex = 0;
  let playTimer: ReturnType<typeof setInterval> | null = null;

  function clearLinks(proto: string) {
    const ids = LINK_ID[proto];
    for (const key in ids) {
      const el = document.getElementById(ids[key]);
      if (el) el.setAttribute("class", "lab-link");
    }
  }

  function clearPackets(proto: string) {
    const g = document.getElementById(`${proto}-packets`);
    if (g) g.innerHTML = "";
  }

  function spawnPacket(proto: string, from: string, to: string) {
    const nodes = NODES[proto];
    const a = nodes[from];
    const b = nodes[to];
    if (!a || !b) return;
    const g = document.getElementById(`${proto}-packets`);
    if (!g) return;
    const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    circle.setAttribute("cx", String(a.x));
    circle.setAttribute("cy", String(a.y));
    circle.setAttribute("r", "8");
    const fill = proto === "dv" ? "var(--slate)" : proto === "eigrp" ? "var(--coral)" : "var(--violet)";
    circle.setAttribute("fill", fill);
    circle.setAttribute("stroke", "#fff");
    circle.setAttribute("stroke-width", "2");
    (circle.style as any).transition = "cx 1s ease, cy 1s ease";
    g.appendChild(circle);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        circle.setAttribute("cx", String(b.x));
        circle.setAttribute("cy", String(b.y));
      });
    });
  }

  function renderStep(proto: string, index: number) {
    const steps = STEPS[proto];
    const step = steps[index];
    clearLinks(proto);
    clearPackets(proto);

    const failMark = document.getElementById(`${proto}-fail-mark`);
    if (failMark) failMark.style.display = step.showFail ? "" : "none";

    (step.active || []).forEach((key) => {
      const id = LINK_ID[proto][key];
      const el = id && document.getElementById(id);
      if (el) el.classList.add("lab-active");
    });
    (step.feasible || []).forEach((key) => {
      const id = LINK_ID[proto][key];
      const el = id && document.getElementById(id);
      if (el) el.classList.add("lab-fs");
    });
    (step.dead || []).forEach((key) => {
      const id = LINK_ID[proto][key];
      const el = id && document.getElementById(id);
      if (el) el.classList.add("lab-dead");
    });

    (step.packets || []).forEach((p) => spawnPacket(proto, p.from, p.to));

    const desc = document.getElementById(`${proto}-desc`);
    if (desc) desc.innerHTML = step.desc;
    const table = document.getElementById(`${proto}-table`);
    if (table) table.innerHTML = step.table;

    const stepnum = document.getElementById("lab-stepnum");
    if (stepnum) stepnum.textContent = `${index + 1} / ${steps.length}`;
  }

  function goTo(index: number) {
    const steps = STEPS[currentProto];
    currentIndex = Math.max(0, Math.min(steps.length - 1, index));
    renderStep(currentProto, currentIndex);
    if (currentIndex === steps.length - 1) stopPlay();
  }

  function stopPlay() {
    if (playTimer) { clearInterval(playTimer); playTimer = null; }
    const btn = document.getElementById("lab-play");
    if (btn) btn.textContent = "▶ Play";
  }

  function togglePlay() {
    if (playTimer) { stopPlay(); return; }
    const steps = STEPS[currentProto];
    if (currentIndex >= steps.length - 1) currentIndex = -1;
    const btn = document.getElementById("lab-play");
    if (btn) btn.textContent = "⏸ Pause";
    playTimer = setInterval(() => {
      const s = STEPS[currentProto];
      if (currentIndex >= s.length - 1) { stopPlay(); return; }
      currentIndex += 1;
      renderStep(currentProto, currentIndex);
    }, 2200);
  }

  function switchProto(proto: string) {
    stopPlay();
    currentProto = proto;
    currentIndex = 0;
    document.querySelectorAll<HTMLElement>(".lab-tab").forEach((btn) => {
      const active = btn.dataset.proto === proto;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-selected", String(active));
    });
    document.querySelectorAll<HTMLElement>(".lab-stage").forEach((stage) => {
      stage.hidden = stage.dataset.stage !== proto;
    });
    renderStep(proto, 0);
  }

  document.querySelectorAll<HTMLElement>(".lab-tab").forEach((btn) => {
    btn.addEventListener("click", () => switchProto(btn.dataset.proto || "dv"));
  });
  document.getElementById("lab-next")?.addEventListener("click", () => { stopPlay(); goTo(currentIndex + 1); });
  document.getElementById("lab-prev")?.addEventListener("click", () => { stopPlay(); goTo(currentIndex - 1); });
  document.getElementById("lab-reset")?.addEventListener("click", () => { stopPlay(); goTo(0); });
  document.getElementById("lab-play")?.addEventListener("click", togglePlay);

  switchProto("dv");
</script>
