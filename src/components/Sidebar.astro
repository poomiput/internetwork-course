---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "");

const units = [
  {
    title: "Layer 2 พื้นฐาน",
    accent: "var(--slate)",
    chapters: [
      { n: 0, slug: "ch0", title: "Overview Internetworking", ready: false },
      { n: 1, slug: "ch1", title: "Packet Forwarding", ready: true },
      { n: 2, slug: "ch2", title: "Spanning Tree", ready: true },
      { n: 3, slug: "ch3", title: "Advanced STP Tuning", ready: true },
      { n: 4, slug: "ch4", title: "Multiple Spanning Tree", ready: true },
      { n: 5, slug: "ch5", title: "VLAN Trunks & EtherChannel", ready: true },
    ],
  },
  {
    title: "Layer 3 Routing",
    accent: "var(--coral)",
    chapters: [
      { n: 6, slug: "ch6", title: "IP Routing Essentials", ready: true },
      { n: 7, slug: "ch7", title: "EIGRP", ready: true },
      { n: 8, slug: "ch8", title: "OSPF", ready: true },
      { n: 9, slug: "ch9", title: "Advanced OSPF", ready: true },
      { n: 10, slug: "ch10", title: "OSPFv3", ready: true },
    ],
  },
  {
    title: "Routing ขั้นสูง & Services",
    accent: "var(--violet)",
    chapters: [
      { n: 11, slug: "ch11", title: "BGP", ready: true },
      { n: 12, slug: "ch12", title: "Advanced BGP", ready: true },
      { n: 13, slug: "ch13", title: "Multicast", ready: true },
      { n: 14, slug: "ch14", title: "QoS", ready: false },
    ],
  },
  {
    title: "Interactive Lab",
    accent: "var(--fwd)",
    chapters: [
      { n: "▶", slug: "routing-lab", title: "IGP Routing Animation", ready: true },
    ],
  },
  {
    title: "ก่อนเข้าห้องสอบ",
    accent: "var(--gold)",
    chapters: [
      { n: "★", slug: "exam", title: "บทสวดขอให้สอบดี", ready: true },
    ],
  },
];
---

<aside class="sidebar">
  <div class="brand">
    <span class="brand-name">Internetwork</span>
    <span class="brand-sub">CCNP Enterprise Core</span>
  </div>

  <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="chapter-nav">
    <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
    <span>เมนูบทเรียน</span>
  </button>

  <nav id="chapter-nav">
    {units.map((unit) => (
      <div class="unit">
        <p class="unit-title" style={`--accent:${unit.accent}`}>{unit.title}</p>
        <ul>
          {unit.chapters.map((ch) => (
            <li>
              <a
                href={`${base.replace(/\/$/, "")}/${ch.slug}`}
                class:list={["chlink", { active: path === `/${ch.slug}`, soon: !ch.ready }]}
                style={`--accent:${unit.accent}`}
              >
                <span class="chnum">{ch.n}</span>
                <span class="chtitle">{ch.title}</span>
                {!ch.ready && <span class="badge">เร็ว ๆ นี้</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const sidebar = document.querySelector(".sidebar");
  if (toggle && sidebar) {
    toggle.addEventListener("click", () => {
      const open = sidebar.classList.toggle("nav-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>

<style>
  .sidebar{
    width:260px;flex:none;
    border-right:1px solid var(--rule-soft);
    padding:24px 18px 40px;
    position:sticky;top:0;
    height:100vh;overflow-y:auto;
  }
  .brand{display:flex;flex-direction:column;gap:2px;margin-bottom:24px;padding:0 6px}
  .brand-name{font-family:var(--serif);font-size:1.2rem;color:var(--ink)}
  .brand-sub{font-size:.72rem;color:var(--ink-3);letter-spacing:.05em}

  .unit{margin-bottom:22px}
  .unit-title{
    font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;
    color:var(--accent);margin:0 0 8px;padding:0 6px;
  }
  ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}

  .chlink{
    display:flex;align-items:center;gap:10px;
    text-decoration:none;color:var(--ink-2);
    padding:8px 6px;border-radius:8px;font-size:.86rem;min-height:44px;
  }
  .chlink:hover{background:var(--paper-2)}
  .chlink.active{
    color:var(--ink);font-weight:700;
    background:color-mix(in srgb, var(--accent) 12%, var(--paper));
  }
  .chnum{
    font-family:var(--mono);font-size:.72rem;color:var(--ink-3);
    width:18px;flex:none;text-align:right;
  }
  .chlink.active .chnum{color:var(--accent)}
  .chtitle{flex:1;line-height:1.3}
  .chlink.soon .chtitle{color:var(--ink-3)}
  .badge{
    font-size:.62rem;color:var(--ink-3);background:var(--paper-2);
    border:1px solid var(--rule-soft);padding:1px 6px;border-radius:999px;
    flex:none;white-space:nowrap;
  }

  .nav-toggle{
    display:none;align-items:center;gap:10px;
    width:100%;border:none;background:none;cursor:pointer;
    padding:10px 12px;margin:0 0 4px;border-radius:8px;
    font:inherit;font-size:.86rem;font-weight:700;color:var(--ink);min-height:44px;
  }
  .nav-toggle:hover{background:var(--paper-2)}
  .nav-toggle:focus-visible{outline:2px solid var(--ink-3);outline-offset:2px}

  .hamburger{flex:none;width:18px;height:13px;position:relative}
  .hamburger span{
    position:absolute;left:0;right:0;height:2px;background:currentColor;border-radius:1px;
    transition:transform .2s ease,opacity .2s ease;
  }
  .hamburger span:nth-child(1){top:0}
  .hamburger span:nth-child(2){top:5.5px}
  .hamburger span:nth-child(3){top:11px}
  .sidebar.nav-open .hamburger span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
  .sidebar.nav-open .hamburger span:nth-child(2){opacity:0}
  .sidebar.nav-open .hamburger span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}

  @media (min-width: 861px) and (max-width: 1024px){
    .sidebar{width:220px}
  }

  @media (max-width: 860px){
    .sidebar{
      position:static;height:auto;width:100%;
      border-right:none;border-bottom:1px solid var(--rule-soft);
      padding:16px 18px;
    }
    .nav-toggle{display:flex}
    #chapter-nav{display:none}
    .sidebar.nav-open #chapter-nav{display:block}
  }
</style>
